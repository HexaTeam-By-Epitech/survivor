    "vue-tsc": "^2.1.4",
    "@vue/test-utils": "^2.4.1",
    "vitest": "^0.34.6",
    "jsdom": "^22.1.0",
    "@vitest/ui": "^0.34.6",
    "playwright": "^1.39.0",
    "eslint": "^8.50.0",
    "@typescript-eslint/parser": "^6.7.4",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "prettier": "^3.0.3",
